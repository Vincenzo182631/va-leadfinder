{
  "name": "@vlf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/node.ts",
    "start": "tsx --env-file-if-exists=../../.env src/node.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/scripts/seed-demo.ts",
    "seed:dev-users": "tsx --env-file-if-exists=../../.env src/scripts/seed-dev-users.ts",
    "paymongo:create-plans": "tsx --env-file-if-exists=../../.env src/scripts/paymongo-create-plans.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && wrangler deploy --dry-run --outdir dist",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@vlf/shared": "workspace:*",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "wrangler": "^4.156.0"
  }
}
