# VA LeadFinder — environment variables (names + non-secret placeholders only).
# [browser] = safe to expose (bundled by Vite). [server] = backend only, NEVER in the web bundle, Git or logs.
# Local dev: copy to .env. Workers: set [server] secrets with `wrangler secret put NAME`.

# ---------- App ----------
APP_ENV=development                      # [server] development | test | staging | production
APP_BASE_URL=http://localhost:5173       # [server] public web origin; used in emails, return URLs
CORS_ORIGINS=http://localhost:5173       # [server] comma-separated allowed browser origins
API_PORT=8787                            # [server] local Node API port (not used on Workers)

# ---------- Database ----------
DATABASE_URL=postgres://postgres@127.0.0.1:54329/vlf   # [server] Postgres URL (Supabase pooler/Hyperdrive in prod)
DATABASE_PREPARE=true                    # [server] set false for Supabase transaction pooler (port 6543)
LOCAL_PG_PORT=54329                      # [server] local Postgres port used by scripts/db-local.sh

# ---------- Auth ----------
AUTH_MODE=local                          # [server] local (DEV ONLY, refused in staging/production) | supabase
LOCAL_AUTH_JWT_SECRET=change-me-dev-only-at-least-32-characters   # [server] dev-only token signing secret (>=32 chars)
SUPABASE_URL=                            # [server] https://<project>.supabase.co (JWT issuer + JWKS)
SUPABASE_JWT_SECRET=                     # [server] only if project still uses legacy HS256 JWT secret
SUPABASE_SERVICE_ROLE_KEY=               # [server] used only for admin account deletion; never in browser
ADMIN_USER_IDS=                          # [server] comma-separated auth user UUIDs with admin access
INTERNAL_JOB_TOKEN=                      # [server] >=32 chars; bearer token for POST /api/internal/jobs/:job

# ---------- Billing (PayMongo) ----------
PAYMONGO_MODE=disabled                   # [server] disabled | mock (dev only) | test | live
PAYMONGO_SECRET_KEY=                     # [server] sk_test_... for test, sk_live_... for live
PAYMONGO_WEBHOOK_SECRET=                 # [server] webhook endpoint secret (mock mode: any 16+ char dev value)
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300   # [server] max signature timestamp age (replay protection)

# ---------- Email ----------
TRANSACTIONAL_EMAIL_PROVIDER=console     # [server] console (dev: logs only) | resend | disabled
TRANSACTIONAL_EMAIL_API_KEY=             # [server] Resend API key
TRANSACTIONAL_EMAIL_FROM=                # [server] verified sender, e.g. "VA LeadFinder <hello@yourdomain>"

# ---------- Licensed opportunity provider (disabled until contract signed) ----------
LICENSED_PROVIDER_ENABLED=false          # [server] feature flag; source must ALSO pass admin compliance gate
APPROVED_OPPORTUNITY_PROVIDER_ID=        # [server] reserved: provider identifier
APPROVED_OPPORTUNITY_PROVIDER_KEY=       # [server] vendor API key
APPROVED_OPPORTUNITY_PROVIDER_BASE_URL=  # [server] vendor API base URL

# ---------- Web (Vite) ----------
VITE_AUTH_MODE=local                     # [browser] local | supabase (must match AUTH_MODE)
VITE_API_BASE_URL=                       # [browser] API origin; empty = same origin / dev proxy
VITE_SUPABASE_URL=                       # [browser] Supabase project URL
VITE_SUPABASE_ANON_KEY=                  # [browser] Supabase anon/publishable key (RLS protects data)
VITE_PAYMONGO_PUBLIC_KEY=                # [browser] pk_test_/pk_live_ key for client-side card tokenization
